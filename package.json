{
  "name": "pi_matters",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 execute pi-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute pi-db --remote --file=./migrations/0001_init.sql",
    "db:migrate:remote:0002": "wrangler d1 execute pi-db --remote --file=./migrations/0002_phrases.sql",
    "db:migrate:remote:0003": "wrangler d1 execute pi-db --remote --file=./migrations/0003_dictionary_cache.sql",
    "types": "wrangler types --include-runtime=false"
  },

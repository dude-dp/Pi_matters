{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pi-matters",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "pi_db",
			"database_name": "pi-db",
			"database_id": "d973e825-fc1d-43de-b32e-e198e95b6e5e",
			"remote": true
		}
	]
}
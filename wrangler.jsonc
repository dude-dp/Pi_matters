{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-matters",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pi-db",
      "database_id": "pi-db-local-id"
    }
  ]
}
